#: src/astrodoro/ui/main.py:585
msgid "Ends the session and closes the camera.\nThe final stack is always written to disk before finishing."
msgstr "Encerra a sessão e fecha a câmera.\nO stack final é sempre gravado em disco antes de encerrar."

#: src/astrodoro/ui/main.py:4451
msgid "Esc returns to live"
msgstr "Esc volta ao vivo"

#: src/astrodoro/ui/design.py:574
