msgid "READY"
msgstr "PRONTO"

#: src/astrodoro/ui/main.py:4058
msgid "REALIGNING"
msgstr "REALINHANDO"

#: src/astrodoro/ui/main.py:4061
msgid "RECORDING"
msgstr "GRAVANDO"

#: src/astrodoro/ui/main.py:4059
msgid "REPLAY"
msgstr "REPLAY"

