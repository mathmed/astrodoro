msgid "N"
msgstr "N"

#: src/astrodoro/core/tonight.py:544 src/astrodoro/ui/skymap.py:33
msgid "NE"
msgstr "NE"

#: src/astrodoro/core/tonight.py:544
msgid "NNE"
msgstr "NNE"

#: src/astrodoro/core/tonight.py:547
msgid "NNW"
msgstr "NNO"

#: src/astrodoro/core/tonight.py:547 src/astrodoro/ui/skymap.py:34
