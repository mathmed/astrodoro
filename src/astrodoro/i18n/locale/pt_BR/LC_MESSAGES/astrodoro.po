msgid "READY"
msgstr "PRONTO"

#: src/astrodoro/ui/main.py:4038
msgid "REALIGNING"
msgstr "REALINHANDO"

#: src/astrodoro/ui/main.py:4041
msgid "RECORDING"
msgstr "GRAVANDO"

#: src/astrodoro/ui/main.py:4039
msgid "REPLAY"
msgstr "REPLAY"

